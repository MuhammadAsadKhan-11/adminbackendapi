# ── Firebase (koi EK option use karo) ─────────────────────────────
# Option A: service account JSON file ka path (local development)
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json
# Option B: poori JSON ek line mai (Render / Railway par deploy ke liye)
# FIREBASE_CREDENTIALS_JSON={"type":"service_account", ...}

# ── Security ──────────────────────────────────────────────────────
# true  => har request par Firebase ID token + admins collection check
# false => sirf local testing ke liye
REQUIRE_AUTH=true
CORS_ORIGINS=*

# ── Business settings ─────────────────────────────────────────────
APP_TIMEZONE=Asia/Karachi
TARIFF_PKR_PER_KWH=45
HIGH_RISK_THRESHOLD=80
MEDIUM_RISK_THRESHOLD=50
CACHE_TTL_SECONDS=10
# latest | all
TOTAL_CONSUMPTION_MODE=latest

# ── Firestore collection names ────────────────────────────────────
CONSUMERS_COLLECTION=consumers
CONSUMPTIONS_COLLECTION=consumptions
CASES_COLLECTION=cases
ADMINS_COLLECTION=admins

THEFT_LOSS_FRACTION=0.25
THEFT_CASE_ISSUE_TYPES=

# ── Case Management (naye endpoints) ──────────────────────────────
# Firestore collection jahan inspectors ki list hai. Khali/na-maujood ho to
# cases mai pehle se use ho rahe assignedInspector names fallback ki tarah use hote hain.
INSPECTORS_COLLECTION=inspectors

# Evidence images/PDFs is Firebase Storage bucket mai upload hote hain.
# Khali chhodo to default bucket (<project-id>.appspot.com) use hoga.
FIREBASE_STORAGE_BUCKET=

# Naya case bane / escalate ho / close ho to consumer ko Expo push bhejna hai ya nahi
# (consumer ke Firestore doc mai "pushToken" field honi chahiye).
SEND_PUSH_NOTIFICATIONS=true

# ── AWS S3 evidence storage (backend only — never in the app) ─────
# The bucket must stay PRIVATE (Block Public Access ON). Files are
# downloaded through short-lived presigned URLs created by this API.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
# optional
AWS_S3_PREFIX=case-evidence
EVIDENCE_MAX_FILE_MB=15
EVIDENCE_MAX_FILES=10
PRESIGNED_URL_TTL_SECONDS=600

# ── Email OTP / 2FA via EmailJS (backend only) ───────────────────
# Same values as the app used before. EXPO_PUBLIC_EMAILJS_* names are
# also accepted. In EmailJS → Account → Security, enable
# "Allow EmailJS API for non-browser applications".

REQUIRE_2FA=true
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
TWO_FA_TRUST_DAYS=7
